//
// IPA modules
//

cc_library_static {
    name: "libcamera_ipa",
    defaults: ["libcamera_private_defaults"],
    shared_libs: [
        "libcamera",
        "libcamera-base",
    ],
    export_include_dirs: ["src/ipa"],
    srcs: [
        "src/ipa/libipa/agc_mean_luminance.cpp",
        "src/ipa/libipa/algorithm.cpp",
        "src/ipa/libipa/awb.cpp",
        "src/ipa/libipa/awb_bayes.cpp",
        "src/ipa/libipa/awb_grey.cpp",
        "src/ipa/libipa/camera_sensor_helper.cpp",
        "src/ipa/libipa/colours.cpp",
        "src/ipa/libipa/exposure_mode_helper.cpp",
        "src/ipa/libipa/fc_queue.cpp",
        "src/ipa/libipa/fixedpoint.cpp",
        "src/ipa/libipa/histogram.cpp",
        "src/ipa/libipa/interpolator.cpp",
        "src/ipa/libipa/lsc_polynomial.cpp",
        "src/ipa/libipa/lux.cpp",
        "src/ipa/libipa/module.cpp",
        "src/ipa/libipa/pwl.cpp",
        "src/ipa/libipa/quantized.cpp",
        "src/ipa/libipa/v4l2_params.cpp",
    ],
}

// Loaded by libcamera from IPA_MODULE_DIR, not linked against.
cc_library_shared {
    name: "ipa_soft_simple",
    defaults: ["libcamera_private_defaults"],
    relative_install_path: "libcamera/ipa",
    local_include_dirs: ["src/ipa/simple"],
    shared_libs: [
        "libcamera",
        "libcamera-base",
    ],
    static_libs: ["libcamera_ipa"],
    required: ["libcamera_ipa_simple_uncalibrated.yaml"],
    srcs: [
        "src/ipa/simple/algorithms/adjust.cpp",
        "src/ipa/simple/algorithms/agc.cpp",
        "src/ipa/simple/algorithms/awb.cpp",
        "src/ipa/simple/algorithms/blc.cpp",
        "src/ipa/simple/algorithms/ccm.cpp",
        "src/ipa/simple/ipa_context.cpp",
        "src/ipa/simple/soft_simple.cpp",
    ],
}

prebuilt_etc {
    name: "libcamera_ipa_simple_uncalibrated.yaml",
    vendor: true,
    src: "src/ipa/simple/data/uncalibrated.yaml",
    filename: "uncalibrated.yaml",
    sub_dir: "libcamera/ipa/simple",
}

//
// Android camera HAL
//

cc_library_shared {
    name: "camera.libcamera",
    defaults: ["libcamera_private_defaults"],
    relative_install_path: "hw",
    header_libs: [
        "libhardware_headers",
    ],
    shared_libs: [
        "libcamera",
        "libcamera-base",
        "libcamera_metadata",
        "libcutils",
        "libexif",
        "libhardware",
        "libjpeg",
        "liblog",
    ],
    static_libs: [
        "libyaml",
        "libyuv_static",
    ],
    required: ["ipa_soft_simple"],
    srcs: [
        "src/android/camera3_hal.cpp",
        "src/android/camera_capabilities.cpp",
        "src/android/camera_device.cpp",
        "src/android/camera_hal_config.cpp",
        "src/android/camera_hal_manager.cpp",
        "src/android/camera_metadata.cpp",
        "src/android/camera_ops.cpp",
        "src/android/camera_request.cpp",
        "src/android/camera_stream.cpp",
        "src/android/hal_framebuffer.cpp",
        "src/android/jpeg/encoder_libjpeg.cpp",
        "src/android/jpeg/exif.cpp",
        "src/android/jpeg/post_processor_jpeg.cpp",
        "src/android/jpeg/thumbnailer.cpp",
        "src/android/mm/generic_camera_buffer.cpp",
        "src/android/mm/generic_frame_buffer_allocator.cpp",
        "src/android/yuv/post_processor_yuv.cpp",
    ],
}

//
// Applications
//

cc_binary {
    name: "cam",
    defaults: ["libcamera_defaults"],
    shared_libs: [
        "libcamera",
        "libcamera-base",
        "libevent",
    ],
    static_libs: ["libyaml"],
    generated_headers: ["libcamera_libcamera_h"],
    local_include_dirs: ["src/apps"],
    required: ["ipa_soft_simple"],
    srcs: [
        "src/apps/cam/camera_session.cpp",
        "src/apps/cam/capture_script.cpp",
        "src/apps/cam/file_sink.cpp",
        "src/apps/cam/frame_sink.cpp",
        "src/apps/cam/main.cpp",
        "src/apps/common/event_loop.cpp",
        "src/apps/common/image.cpp",
        "src/apps/common/options.cpp",
        "src/apps/common/ppm_writer.cpp",
        "src/apps/common/stream_options.cpp",
    ],
}
