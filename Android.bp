package {
    default_visibility: [
        ":__subpackages__",
        "//vendor:__subpackages__",
        "//device:__subpackages__",
    ],
}

//
// Code generation
//

genrule {
    name: "libcamera_version_h",
    srcs: ["include/libcamera/version.h.in"],
    cmd: "sed -e 's/@LIBCAMERA_VERSION_MAJOR@/0/' " +
        "-e 's/@LIBCAMERA_VERSION_MINOR@/7/' " +
        "-e 's/@LIBCAMERA_VERSION_PATCH@/2/' " +
        "$(in) > $(out)",
    out: ["include/libcamera/version.h"],
    export_include_dirs: ["include"],
}

genrule {
    name: "libcamera_version_cpp",
    srcs: ["src/libcamera/version.cpp.in"],
    cmd: "sed -e 's/@VCS_TAG@/0.7.2+android/' $(in) > $(out)",
    out: ["src/libcamera/version.cpp"],
}

genrule {
    name: "libcamera_control_ids_h",
    srcs: [
        "src/libcamera/control_ids_core.yaml",
        "src/libcamera/control_ids_debug.yaml",
        "src/libcamera/control_ids_draft.yaml",
    ],
    tool_files: [
        "include/libcamera/control_ids.h.in",
        "src/libcamera/control_ranges.yaml",
        "utils/codegen/controls.py",
        "utils/codegen/gen-controls.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/gen-controls.py)" +
        " -o $(out) --mode controls" +
        " -t $(location include/libcamera/control_ids.h.in)" +
        " -r $(location src/libcamera/control_ranges.yaml)" +
        " $(in)",
    out: ["include/libcamera/control_ids.h"],
    export_include_dirs: [
        "include",
        "include/libcamera",
    ],
}

genrule {
    name: "libcamera_control_ids_cpp",
    srcs: [
        "src/libcamera/control_ids_core.yaml",
        "src/libcamera/control_ids_debug.yaml",
        "src/libcamera/control_ids_draft.yaml",
    ],
    tool_files: [
        "src/libcamera/control_ids.cpp.in",
        "src/libcamera/control_ranges.yaml",
        "utils/codegen/controls.py",
        "utils/codegen/gen-controls.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/gen-controls.py)" +
        " -o $(out) --mode controls" +
        " -t $(location src/libcamera/control_ids.cpp.in)" +
        " -r $(location src/libcamera/control_ranges.yaml)" +
        " $(in)",
    out: ["src/libcamera/control_ids.cpp"],
}

genrule {
    name: "libcamera_property_ids_h",
    srcs: [
        "src/libcamera/property_ids_core.yaml",
        "src/libcamera/property_ids_draft.yaml",
    ],
    tool_files: [
        "include/libcamera/control_ids.h.in",
        "src/libcamera/control_ranges.yaml",
        "utils/codegen/controls.py",
        "utils/codegen/gen-controls.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/gen-controls.py)" +
        " -o $(out) --mode properties" +
        " -t $(location include/libcamera/control_ids.h.in)" +
        " -r $(location src/libcamera/control_ranges.yaml)" +
        " $(in)",
    out: ["include/libcamera/property_ids.h"],
    export_include_dirs: ["include"],
}

genrule {
    name: "libcamera_property_ids_cpp",
    srcs: [
        "src/libcamera/property_ids_core.yaml",
        "src/libcamera/property_ids_draft.yaml",
    ],
    tool_files: [
        "src/libcamera/control_ids.cpp.in",
        "src/libcamera/control_ranges.yaml",
        "utils/codegen/controls.py",
        "utils/codegen/gen-controls.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/gen-controls.py)" +
        " -o $(out) --mode properties" +
        " -t $(location src/libcamera/control_ids.cpp.in)" +
        " -r $(location src/libcamera/control_ranges.yaml)" +
        " $(in)",
    out: ["src/libcamera/property_ids.cpp"],
}

genrule {
    name: "libcamera_formats_h",
    srcs: [
        "src/libcamera/formats.yaml",
        "include/libcamera/formats.h.in",
        "include/linux/drm_fourcc.h",
    ],
    tool_files: ["utils/codegen/gen-formats.py"],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/gen-formats.py)" +
        " -o $(out) $(in)",
    out: ["include/libcamera/formats.h"],
    export_include_dirs: ["include"],
}

genrule {
    name: "libcamera_tracepoints_h",
    srcs: [
        "include/libcamera/internal/tracepoints.h.in",
        "include/libcamera/internal/tracepoints/buffer_enums.tp",
        "include/libcamera/internal/tracepoints/request_enums.tp",
        "include/libcamera/internal/tracepoints/pipeline.tp",
        "include/libcamera/internal/tracepoints/request.tp",
    ],
    tool_files: ["utils/codegen/gen-tp-header.py"],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/gen-tp-header.py)" +
        " $$PWD/$(genDir)/include $(out) $(in)",
    out: ["include/libcamera/internal/tracepoints.h"],
    export_include_dirs: ["include"],
}

genrule {
    name: "libcamera_libcamera_h",
    srcs: [
        "include/libcamera/camera.h",
        "include/libcamera/camera_manager.h",
        "include/libcamera/color_space.h",
        "include/libcamera/controls.h",
        "include/libcamera/fence.h",
        "include/libcamera/framebuffer.h",
        "include/libcamera/framebuffer_allocator.h",
        "include/libcamera/geometry.h",
        "include/libcamera/logging.h",
        "include/libcamera/orientation.h",
        "include/libcamera/pixel_format.h",
        "include/libcamera/request.h",
        "include/libcamera/stream.h",
        "include/libcamera/transform.h",
        ":libcamera_control_ids_h",
        ":libcamera_property_ids_h",
        ":libcamera_formats_h",
        ":libcamera_version_h",
    ],
    tool_files: ["utils/codegen/gen-header.sh"],
    cmd: "$(location utils/codegen/gen-header.sh) $(out) $(in)",
    out: ["include/libcamera/libcamera.h"],
    export_include_dirs: ["include"],
}

//
// IPA interface code generation (mojom)
//

filegroup {
    name: "libcamera_mojom_codegen_srcs",
    srcs: [
        "utils/codegen/ipc/generators/**/*",
        "utils/codegen/ipc/mojo/**/*.py",
        "utils/codegen/ipc/tools/**/*.py",
    ],
}

genrule {
    name: "libcamera_mojom_templates",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        "utils/codegen/ipc/generate.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/ipc/generate.py)" +
        " -o $(genDir) precompile",
    out: ["libcamera_templates.zip"],
}

genrule {
    name: "libcamera_mojom_core_module",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        "include/libcamera/ipa/core.mojom",
        "utils/codegen/ipc/parser.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/ipc/parser.py)" +
        " --output-root $(genDir)" +
        " --input-root $$(dirname $(location include/libcamera/ipa/core.mojom))/../../.." +
        " --mojoms $(location include/libcamera/ipa/core.mojom)",
    out: ["include/libcamera/ipa/core.mojom-module"],
}

genrule {
    name: "libcamera_mojom_soft_module",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        ":libcamera_mojom_core_module",
        "include/libcamera/ipa/core.mojom",
        "include/libcamera/ipa/soft.mojom",
        "utils/codegen/ipc/parser.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: "$(location libcamera_codegen_host)" +
        " $(location utils/codegen/ipc/parser.py)" +
        " --output-root $(genDir)" +
        " --input-root $$(dirname $(location include/libcamera/ipa/soft.mojom))/../../.." +
        " --module-root $$(dirname $(location :libcamera_mojom_core_module))/../../.." +
        " --mojoms $(location include/libcamera/ipa/soft.mojom)",
    out: ["include/libcamera/ipa/soft.mojom-module"],
}

// Arguments common to all IPC code generation steps, the generator mode
// option, output path and mojom module are appended by each rule.
libcamera_mojom_generate = "$(location libcamera_codegen_host)" +
    " $(location utils/codegen/ipc/generate.py) generate -g libcamera" +
    " --bytecode_path $$(dirname $(location :libcamera_mojom_templates))"

genrule {
    name: "libcamera_core_ipa_interface_h",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        ":libcamera_mojom_templates",
        ":libcamera_mojom_core_module",
        "utils/codegen/ipc/generate.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: libcamera_mojom_generate +
        " --libcamera_generate_core_header" +
        " --libcamera_output_path=$(out)" +
        " $(location :libcamera_mojom_core_module)",
    out: ["include/libcamera/ipa/core_ipa_interface.h"],
    export_include_dirs: [
        "include",
        "include/libcamera/ipa",
    ],
}

genrule {
    name: "libcamera_core_ipa_serializer_h",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        ":libcamera_mojom_templates",
        ":libcamera_mojom_core_module",
        "utils/codegen/ipc/generate.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: libcamera_mojom_generate +
        " --libcamera_generate_core_serializer" +
        " --libcamera_output_path=$(out)" +
        " $(location :libcamera_mojom_core_module)",
    out: ["include/libcamera/ipa/core_ipa_serializer.h"],
    export_include_dirs: [
        "include",
        "include/libcamera/ipa",
    ],
}

genrule {
    name: "libcamera_soft_ipa_interface_h",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        ":libcamera_mojom_templates",
        ":libcamera_mojom_soft_module",
        "utils/codegen/ipc/generate.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: libcamera_mojom_generate +
        " --libcamera_generate_header" +
        " --libcamera_output_path=$(out)" +
        " $(location :libcamera_mojom_soft_module)",
    out: ["include/libcamera/ipa/soft_ipa_interface.h"],
    export_include_dirs: [
        "include",
        "include/libcamera/ipa",
    ],
}

genrule {
    name: "libcamera_soft_ipa_serializer_h",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        ":libcamera_mojom_templates",
        ":libcamera_mojom_soft_module",
        "utils/codegen/ipc/generate.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: libcamera_mojom_generate +
        " --libcamera_generate_serializer" +
        " --libcamera_output_path=$(out)" +
        " $(location :libcamera_mojom_soft_module)",
    out: ["include/libcamera/ipa/soft_ipa_serializer.h"],
    export_include_dirs: [
        "include",
        "include/libcamera/ipa",
    ],
}

genrule {
    name: "libcamera_soft_ipa_proxy_h",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        ":libcamera_mojom_templates",
        ":libcamera_mojom_soft_module",
        "utils/codegen/ipc/generate.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: libcamera_mojom_generate +
        " --libcamera_generate_proxy_h" +
        " --libcamera_output_path=$(out)" +
        " $(location :libcamera_mojom_soft_module)",
    out: ["include/libcamera/ipa/soft_ipa_proxy.h"],
    export_include_dirs: [
        "include",
        "include/libcamera/ipa",
    ],
}

genrule {
    name: "libcamera_soft_ipa_proxy_cpp",
    srcs: [
        ":libcamera_mojom_codegen_srcs",
        ":libcamera_mojom_templates",
        ":libcamera_mojom_soft_module",
        "utils/codegen/ipc/generate.py",
    ],
    tools: ["libcamera_codegen_host"],
    cmd: libcamera_mojom_generate +
        " --libcamera_generate_proxy_cpp" +
        " --libcamera_output_path=$(out)" +
        " $(location :libcamera_mojom_soft_module)",
    out: ["src/libcamera/proxy/soft_ipa_proxy.cpp"],
}

//
// Libraries
//

cc_defaults {
    name: "libcamera_defaults",
    vendor: true,
    rtti: true,
    local_include_dirs: ["include"],
    generated_headers: [
        "libcamera_control_ids_h",
        "libcamera_core_ipa_interface_h",
        "libcamera_core_ipa_serializer_h",
        "libcamera_formats_h",
        "libcamera_property_ids_h",
        "libcamera_soft_ipa_interface_h",
        "libcamera_soft_ipa_proxy_h",
        "libcamera_soft_ipa_serializer_h",
        "libcamera_tracepoints_h",
        "libcamera_version_h",
    ],
    cflags: [
        // Equivalent of the config.h generated by meson for bionic.
        "-DHAVE_BACKTRACE=1",
        "-DHAVE_CLOSE_RANGE=1",
        "-DHAVE_FILE_SEALS=1",
        "-DHAVE_LOCALE_T=1",
        "-DHAVE_MEMFD_CREATE=1",
        "-DIPA_CONFIG_DIR=\"/vendor/etc/libcamera/ipa\"",
        "-DIPA_PROXY_DIR=\"/vendor/libexec/libcamera\"",
        "-DLIBCAMERA_DATA_DIR=\"/vendor/etc/libcamera\"",
        "-DLIBCAMERA_SYSCONF_DIR=\"/vendor/etc/libcamera\"",

        "-Wall",
        "-Wextra",
        "-Wmissing-declarations",
        "-Wno-c99-designator",
        "-Wno-error",
        "-Wno-missing-field-initializers",
        "-Wno-unused-parameter",
        "-Wshadow",
    ],
    cppflags: [
        "-Wextra-semi",
        "-Wnon-virtual-dtor",
        "-Wthread-safety",
    ],
    multilib: {
        lib32: {
            cflags: ["-DIPA_MODULE_DIR=\"/vendor/lib/libcamera/ipa\""],
        },
        lib64: {
            cflags: ["-DIPA_MODULE_DIR=\"/vendor/lib64/libcamera/ipa\""],
        },
    },
}

// Users of the internal API, the libcamera_private dependency in meson.
cc_defaults {
    name: "libcamera_private_defaults",
    defaults: ["libcamera_defaults"],
    cflags: ["-DLIBCAMERA_BASE_PRIVATE"],
}

cc_library_shared {
    name: "libcamera-base",
    defaults: ["libcamera_private_defaults"],
    shared_libs: ["liblog"],
    export_include_dirs: ["include"],
    srcs: [
        "src/libcamera/base/backtrace.cpp",
        "src/libcamera/base/bound_method.cpp",
        "src/libcamera/base/class.cpp",
        "src/libcamera/base/event_dispatcher.cpp",
        "src/libcamera/base/event_dispatcher_poll.cpp",
        "src/libcamera/base/event_notifier.cpp",
        "src/libcamera/base/file.cpp",
        "src/libcamera/base/flags.cpp",
        "src/libcamera/base/log.cpp",
        "src/libcamera/base/memfd.cpp",
        "src/libcamera/base/message.cpp",
        "src/libcamera/base/mutex.cpp",
        "src/libcamera/base/object.cpp",
        "src/libcamera/base/semaphore.cpp",
        "src/libcamera/base/shared_fd.cpp",
        "src/libcamera/base/signal.cpp",
        "src/libcamera/base/thread.cpp",
        "src/libcamera/base/timer.cpp",
        "src/libcamera/base/unique_fd.cpp",
        "src/libcamera/base/utils.cpp",
    ],
}

cc_library_shared {
    name: "libcamera",
    defaults: ["libcamera_private_defaults"],
    shared_libs: ["libcamera-base"],
    export_shared_lib_headers: ["libcamera-base"],
    static_libs: ["libyaml"],
    export_include_dirs: ["include"],
    export_generated_headers: [
        "libcamera_control_ids_h",
        "libcamera_core_ipa_interface_h",
        "libcamera_core_ipa_serializer_h",
        "libcamera_formats_h",
        "libcamera_property_ids_h",
        "libcamera_soft_ipa_interface_h",
        "libcamera_soft_ipa_proxy_h",
        "libcamera_soft_ipa_serializer_h",
        "libcamera_tracepoints_h",
        "libcamera_version_h",
    ],
    srcs: [
        ":libcamera_control_ids_cpp",
        ":libcamera_property_ids_cpp",
        ":libcamera_soft_ipa_proxy_cpp",
        ":libcamera_version_cpp",
        "src/libcamera/bayer_format.cpp",
        "src/libcamera/byte_stream_buffer.cpp",
        "src/libcamera/camera.cpp",
        "src/libcamera/camera_controls.cpp",
        "src/libcamera/camera_lens.cpp",
        "src/libcamera/camera_manager.cpp",
        "src/libcamera/clock_recovery.cpp",
        "src/libcamera/color_space.cpp",
        "src/libcamera/control_serializer.cpp",
        "src/libcamera/control_validator.cpp",
        "src/libcamera/controls.cpp",
        "src/libcamera/converter.cpp",
        "src/libcamera/converter/converter_dw100.cpp",
        "src/libcamera/converter/converter_dw100_vertexmap.cpp",
        "src/libcamera/converter/converter_v4l2_m2m.cpp",
        "src/libcamera/debug_controls.cpp",
        "src/libcamera/delayed_controls.cpp",
        "src/libcamera/device_enumerator.cpp",
        "src/libcamera/device_enumerator_sysfs.cpp",
        "src/libcamera/dma_buf_allocator.cpp",
        "src/libcamera/fence.cpp",
        "src/libcamera/formats.cpp",
        "src/libcamera/framebuffer.cpp",
        "src/libcamera/framebuffer_allocator.cpp",
        "src/libcamera/geometry.cpp",
        "src/libcamera/global_configuration.cpp",
        "src/libcamera/ipa_controls.cpp",
        "src/libcamera/ipa_data_serializer.cpp",
        "src/libcamera/ipa_interface.cpp",
        "src/libcamera/ipa_manager.cpp",
        "src/libcamera/ipa_module.cpp",
        "src/libcamera/ipa_proxy.cpp",
        "src/libcamera/ipc_pipe.cpp",
        "src/libcamera/ipc_pipe_unixsocket.cpp",
        "src/libcamera/ipc_unixsocket.cpp",
        "src/libcamera/mapped_framebuffer.cpp",
        "src/libcamera/matrix.cpp",
        "src/libcamera/media_device.cpp",
        "src/libcamera/media_object.cpp",
        "src/libcamera/media_pipeline.cpp",
        "src/libcamera/orientation.cpp",
        "src/libcamera/pipeline/simple/simple.cpp",
        "src/libcamera/pipeline_handler.cpp",
        "src/libcamera/pixel_format.cpp",
        "src/libcamera/process.cpp",
        "src/libcamera/pub_key.cpp",
        "src/libcamera/request.cpp",
        "src/libcamera/sensor/camera_sensor.cpp",
        "src/libcamera/sensor/camera_sensor_legacy.cpp",
        "src/libcamera/sensor/camera_sensor_properties.cpp",
        "src/libcamera/sensor/camera_sensor_raw.cpp",
        "src/libcamera/shared_mem_object.cpp",
        "src/libcamera/software_isp/benchmark.cpp",
        "src/libcamera/software_isp/debayer.cpp",
        "src/libcamera/software_isp/debayer_cpu.cpp",
        "src/libcamera/software_isp/software_isp.cpp",
        "src/libcamera/software_isp/swstats_cpu.cpp",
        "src/libcamera/source_paths.cpp",
        "src/libcamera/stream.cpp",
        "src/libcamera/sysfs.cpp",
